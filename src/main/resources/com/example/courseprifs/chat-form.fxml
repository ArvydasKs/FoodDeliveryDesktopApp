<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="426.0" prefWidth="462.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.courseprifs.fxControllers.ChatForm">
   <children>
      <ListView fx:id="messageList" layoutX="21.0" layoutY="14.0" prefHeight="237.0" prefWidth="423.0" />
      <TextArea fx:id="messageBody" layoutX="20.0" layoutY="267.0" prefHeight="84.0" prefWidth="423.0" promptText="Message Text" />
      <Button fx:id="sendMessageButton" layoutX="211.0" layoutY="368.0" mnemonicParsing="false" onAction="#sendMessage" text="Send" />
   </children>
</AnchorPane>
