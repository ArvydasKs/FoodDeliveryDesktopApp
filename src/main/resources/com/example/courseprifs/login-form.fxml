<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="258.0" prefWidth="397.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.courseprifs.fxControllers.LoginForm">
   <children>
      <TextField fx:id="loginField" layoutX="124.0" layoutY="58.0" promptText="Username" />
      <PasswordField fx:id="passwordField" layoutX="124.0" layoutY="97.0" promptText="Password" />
      <Button layoutX="124.0" layoutY="155.0" mnemonicParsing="false" onAction="#validateAndLogin" text="Log In" />
      <Button layoutX="214.0" layoutY="155.0" mnemonicParsing="false" onAction="#registerNewUser" text="Register" />
   </children>
</AnchorPane>
