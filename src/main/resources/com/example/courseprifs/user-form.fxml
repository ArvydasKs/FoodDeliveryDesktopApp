<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="348.0" prefWidth="419.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.courseprifs.fxControllers.UserForm">
   <children>
      <ComboBox fx:id="vehicleTypeField" layoutX="221.0" layoutY="194.0" prefWidth="150.0" promptText="Vehicle Type" />
      <TextField fx:id="usernameField" layoutX="52.0" layoutY="77.0" promptText="Username" />
      <PasswordField fx:id="pswField" layoutX="52.0" layoutY="117.0" promptText="Password" />
      <TextField fx:id="nameField" layoutX="52.0" layoutY="154.0" promptText="Name" />
      <TextField fx:id="surnameField" layoutX="52.0" layoutY="194.0" promptText="Surname" />
      <TextField fx:id="phoneNumField" layoutX="52.0" layoutY="232.0" promptText="Phone Number" />
      <RadioButton fx:id="userRadio" layoutX="52.0" layoutY="36.0" mnemonicParsing="false" onAction="#disableFields" selected="true" text="User">
         <toggleGroup>
            <ToggleGroup fx:id="userType" />
         </toggleGroup>
      </RadioButton>
      <RadioButton fx:id="restaurantRadio" layoutX="113.0" layoutY="36.0" mnemonicParsing="false" onAction="#disableFields" text="Restaurant" toggleGroup="$userType" />
      <RadioButton fx:id="clientRadio" layoutX="202.0" layoutY="36.0" mnemonicParsing="false" onAction="#disableFields" text="Client" toggleGroup="$userType" />
      <RadioButton fx:id="driverRadio" layoutX="259.0" layoutY="36.0" mnemonicParsing="false" onAction="#disableFields" text="Driver" toggleGroup="$userType" />
      <TextField fx:id="addressField" layoutX="221.0" layoutY="77.0" promptText="Address" />
      <TextField fx:id="licenceField" layoutX="221.0" layoutY="117.0" promptText="Licence" />
      <DatePicker fx:id="bDateField" layoutX="221.0" layoutY="154.0" prefHeight="25.0" prefWidth="149.0" promptText="Birthdate" />
      <Button fx:id="createButton" layoutX="189.0" layoutY="285.0" mnemonicParsing="false" onAction="#createUser" text="Create" />
      <Button fx:id="updateButton" disable="true" layoutX="184.0" layoutY="285.0" mnemonicParsing="false" onAction="#updateUser" text="Update" visible="false" />
   </children>
</AnchorPane>
